{
  "name": "vortex-android-recorder",
  "version": "0.8.0-beta.1",
  "description": "Local Android recorder and inspector for MobileWright: TypeScript Plain/POM exports, replay, reports and benchmarks.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "mock": "node src/server.js --mock",
    "test": "node test/run-tests.js && node --test test/recorder-safety.test.mjs \"test/unit/*.test.ts\"",
    "test:legacy": "node test/run-tests.js",
    "test:unit": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node src/check.js",
    "doctor": "node src/doctor.js",
    "bench": "node src/bench/cli.ts",
    "package:windows": "node scripts/package-windows.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@xmldom/xmldom": "0.8.15",
    "typescript": "5.9.3",
    "xpath": "0.0.34"
  }
}
